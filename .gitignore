# ============================================
#  StepperMotorController .gitignore
#  KiCad 6–10 + STM32CubeIDE
# ============================================

# --- Yedekler ---
*-backups/
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*.sch-bak
*~
_autosave-*
\#auto_saved_files\#

# --- Kilit dosyaları (dosya açıkken oluşur) ---
*.lmk
~*.lck
*.lck

# --- Kişisel/yerel ayarlar (açık pencereler, katman görünürlüğü vs.) ---
*.kicad_prl

# --- KiCad 10 yerel geçmiş (Local History) — kendi içinde git reposu ---
.history/

# --- Önbellekler ---
fp-info-cache
*.cache

# --- Raporlar (DRC/ERC çıktıları) ---
*.rpt
*.erc
*.drc

# --- Autorouter (Freerouting) ara dosyaları ---
*.dsn
*.ses

# --- Netlist / BOM gibi yeniden üretilebilir çıktılar ---
*.net
*.xml
*.csv

# --- Üretim çıktıları ---
# Repoya girmez: CI her push'ta üretir, siparişe gidenler GitHub Release'e eklenir
gerber/
gerbers/
fab/
production/
*.gbr
*.gbrjob
*.drl
*.zip

# --- KiCad 5 legacy ---
*.000
*.pro-bak
# NOT: KiCad 5 kullanıyorsan *-cache.lib dosyasını ignore ETME, sembolleri o tutuyor

# --- CI / yerel çıktı klasörleri ---
ci-out/
diff-out/

# --- STM32CubeIDE / firmware derleme çıktıları ---
# (.ioc, .project, .cproject, .mxproject COMMIT'LENİR)
firmware/**/Debug/
firmware/**/Release/
firmware/**/build/
.metadata/
*.launch
*.o
*.d
*.su
*.elf
*.map
*.list
*.hex
*.bin

# --- Gizli bilgiler (asla commit'leme) ---
*.pem
*.key
.env
*token*

# --- İşletim sistemi / editör çöpleri ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

school_files/
other_files/