# ============================================
#  StepperMotorController .gitignore
#  KiCad 6–10 + STM32CubeIDE
# ============================================

# --- Backups ---
*-backups/
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*.sch-bak
*~
_autosave-*
\#auto_saved_files\#

# --- Lock files (created while a file is open) ---
*.lmk
~*.lck
*.lck

# --- Personal/local settings (open windows, layer visibility, etc.) ---
*.kicad_prl

# --- KiCad 10 Local History (a git repo of its own) ---
.history/

# --- Caches ---
fp-info-cache
*.cache

# --- Reports (ERC/DRC output) ---
*.rpt
*.erc
*.drc

# --- Autorouter (Freerouting) intermediate files ---
*.dsn
*.ses

# --- Regenerable outputs (netlist / BOM) ---
*.net
*.xml
*.csv

# --- Fabrication outputs ---
# Not committed: CI generates them on every push; the ordered revision is attached to a GitHub Release
gerber/
gerbers/
fab/
production/
*.gbr
*.gbrjob
*.drl
*.zip

# --- KiCad 5 legacy ---
*.000
*.pro-bak
# NOTE: on KiCad 5 do NOT ignore *-cache.lib, it holds the symbols

# --- CI / local output folders ---
ci-out/
diff-out/

# --- STM32CubeIDE / firmware build outputs ---
# (.ioc, .project, .cproject, .mxproject ARE committed)
firmware/**/Debug/
firmware/**/Release/
firmware/**/build/
.metadata/
*.launch
*.o
*.d
*.su
*.elf
*.map
*.list
*.hex
*.bin

# --- Secrets (never commit) ---
*.pem
*.key
.env
*token*

# --- OS / editor junk ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

school_files/
other_files/
